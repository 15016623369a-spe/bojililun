{
  "name": "fitness-agent",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/ensure-cert.mjs && node scripts/dev-server.mjs",
    "dev:http": "next dev -p 3001",
    "dev:https": "npm run dev",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "shot": "node scripts/shot.mjs",
    "shot:library": "node scripts/shot-library.mjs",
    "shot:training": "node scripts/shot-training.mjs",
    "shot:body": "node scripts/shot-body.mjs",
    "test:ledger": "node --test tests/ledger.cjs",
    "backfill:exercise-metrics": "node scripts/backfill-exercise-metrics.mjs"
  },
  "dependencies": {
    "next": "15.5.29",
    "pinyin-pro": "^3.29.5",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.6.0"
  }
}
